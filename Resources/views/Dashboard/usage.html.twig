<div class="pt-sm pb-sm">
    {% if state == 'success' %}
        <div class="row">
            <div class="{{ chartData is defined ? 'col-xs-7' : 'col-xs-12' }}">
                <ul class="list-group mb-0 bdr-w-0">
                    <li class="box-layout mb-sm">
                        <span class="col-xs-8 va-m dark-sm">{{ 'leuchtfeuerfloodlightb2b.dashboard.usage.plan'|trans }}</span>
                        <span class="col-xs-4 va-m text-right fw-sb">{{ plan }}</span>
                    </li>
                    <li class="box-layout mb-sm">
                        <span class="col-xs-8 va-m dark-sm">{{ 'leuchtfeuerfloodlightb2b.dashboard.usage.monthly_limit'|trans }}</span>
                        <span class="col-xs-4 va-m text-right fw-sb">{{ monthlyLimit }}</span>
                    </li>
                    <li class="box-layout mb-sm">
                        <span class="col-xs-8 va-m dark-sm">{{ 'leuchtfeuerfloodlightb2b.dashboard.usage.remaining'|trans }}</span>
                        <span class="col-xs-4 va-m text-right fw-sb">{{ remaining }}</span>
                    </li>
                    <li class="box-layout mb-sm">
                        <span class="col-xs-8 va-m dark-sm">{{ 'leuchtfeuerfloodlightb2b.dashboard.usage.buffer'|trans }}</span>
                        <span class="col-xs-4 va-m text-right fw-sb">{{ buffer }}</span>
                    </li>
                    <li class="box-layout mb-sm">
                        <span class="col-xs-8 va-t dark-sm">{{ 'leuchtfeuerfloodlightb2b.dashboard.usage.next_renewal'|trans }}</span>
                        <span class="col-xs-4 va-t text-right fw-sb">
                            <span class="text-nowrap">{{ dateToDate(nextRenewal) }}</span><br>({{ 'leuchtfeuerfloodlightb2b.dashboard.usage.days_left'|trans({'%count%': daysLeft}) }})
                        </span>
                    </li>
                </ul>
            </div>
            {% if chartData is defined %}
                <div class="col-xs-5">
                    {{ include('@MauticCore/Helper/chart.html.twig', {
                        chartData: chartData,
                        chartType: 'pie',
                        chartHeight: 140
                    }) }}
                </div>
            {% endif %}
            <div class="col-xs-12 fd-row">
                <a href="{{ portalUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary mr-sm floodlight-b2b-widget-button pr-16">
                    {{ 'leuchtfeuerfloodlightb2b.dashboard.usage.customer_portal'|trans }}
                </a>
                <a href="{{ shopUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary floodlight-b2b-widget-button pr-16">
                    {{ 'leuchtfeuerfloodlightb2b.dashboard.usage.upgrade_plan'|trans }}
                </a>
            </div>
        </div>
    {% elseif state == 'setup' %}
        <div class="alert alert-warning" role="alert">{{ 'leuchtfeuerfloodlightb2b.dashboard.usage.setup_required'|trans }}</div>
    {% elseif state == 'invalid_credentials' %}
        <div class="alert alert-danger" role="alert">{{ 'leuchtfeuerfloodlightb2b.dashboard.usage.invalid_credentials'|trans }}</div>
    {% elseif state == 'rate_limited' %}
        <div class="alert alert-warning" role="alert">{{ 'leuchtfeuerfloodlightb2b.dashboard.usage.rate_limited'|trans }}</div>
    {% else %}
        <div class="alert alert-danger" role="alert">{{ 'leuchtfeuerfloodlightb2b.dashboard.usage.unavailable'|trans }}</div>
    {% endif %}

    {% if state != 'success' %}
        <div class="mt-sm">
            <a href="{{ portalUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary mr-sm floodlight-b2b-widget-button pr-16">
                {{ 'leuchtfeuerfloodlightb2b.dashboard.usage.customer_portal'|trans }}
            </a>
            <a href="{{ shopUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary floodlight-b2b-widget-button pr-16">
                {{ 'leuchtfeuerfloodlightb2b.dashboard.usage.upgrade_plan'|trans }}
            </a>
        </div>
    {% endif %}
</div>
